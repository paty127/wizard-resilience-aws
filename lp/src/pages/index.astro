  <script is:inline>
  (function () {
    var navToggle = document.getElementById("navToggle");
    var navClose = document.getElementById("navClose");
    var navMobile = document.getElementById("navMobile");
    var navOverlay = document.getElementById("navOverlay");

    function openNav() {
      navMobile.classList.add("open");
      navOverlay.classList.add("open");
      navToggle.setAttribute("aria-expanded", "true");
    }

    function closeNav() {
      navMobile.classList.remove("open");
      navOverlay.classList.remove("open");
      navToggle.setAttribute("aria-expanded", "false");
    }

    navToggle.addEventListener("click", openNav);
    navClose.addEventListener("click", closeNav);
    navOverlay.addEventListener("click", closeNav);
    navMobile.querySelectorAll("a").forEach(function (link) { link.addEventListener("click", closeNav); });

    // Se a janela voltar pro tamanho desktop com o menu mobile aberto, fecha
    // (o header desktop já mostra os links, não faz sentido manter o overlay).
    var desktopQuery = window.matchMedia("(min-width: 861px)");
    desktopQuery.addEventListener("change", function (e) {
      if (e.matches) closeNav();
    });

    // Efeito "luzes de cinema" no selo de desconto: no desktop o :hover do CSS
    // já resolve, mas :active não é confiável em toque (iOS só dispara em
    // elemento com handler de touch/click), então alterna a classe no touch.
    var heroVisual = document.querySelector(".hero-visual");
    if (heroVisual) {
      heroVisual.addEventListener("touchstart", function () { heroVisual.classList.add("marquee-active"); }, { passive: true });
      var clearMarquee = function () { heroVisual.classList.remove("marquee-active"); };
      heroVisual.addEventListener("touchend", clearMarquee);
      heroVisual.addEventListener("touchcancel", clearMarquee);
    }
  })();
</script>

<script is:inline>
  // Contador animado das estatísticas do hero e do chip de desconto: conta de
  // 0 até o alvo assim que a página carrega (o hero já aparece na tela sem
  // precisar rolar, então dispara direto — nada de esperar IntersectionObserver
  // aqui, senão fica zerado até o usuário rolar).
  (function () {
    var counters = document.querySelectorAll(".counter");

    function animateCounter(el) {
      var target = Number(el.dataset.target || "0");
      var prefix = el.dataset.prefix || "";
      var suffix = el.dataset.suffix || "";
      var duration = 1200;
      var start = performance.now();

      function tick(now) {
        var progress = Math.min((now - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var value = Math.round(target * eased);
        el.textContent = prefix + value.toLocaleString("pt-BR") + suffix;
        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          el.classList.add("pop");
          setTimeout(function () { el.classList.remove("pop"); }, 250);
        }
      }
      requestAnimationFrame(tick);
    }

    counters.forEach(function (el) { animateCounter(el); });
  })();
</script>

<script is:inline>
  // Unidades: dataset estático (só SP, ver lp/scripts/refresh-units.mjs), gerado
  // no deploy a partir da API da Wizard. Localizador e autocomplete do form
  // rodam 100% no navegador a partir desse JSON — nunca chamam a API da Wizard
  // em produção (só o CEP é geocodificado, via BrasilAPI, que não é da Wizard).
  (function () {
    // Script inline (is:inline) pra tirar essa cadeia do preload scanner —
    // por isso "/" fixo em vez de import.meta.env.BASE_URL (só funciona em
    // script processado pelo Vite/Astro). O projeto não define "base" no
    // astro.config.mjs, então BASE_URL sempre resolveria pra "/" mesmo.
    var BASE_URL = "/";

    var unitsPromise = null;
    function loadUnits() {
      if (!unitsPromise) {
        unitsPromise = fetch(BASE_URL + "data/units-sp.json")
          .then(function (r) { return r.json(); })
          .then(function (data) { return data.units; })
          .catch(function () { return []; });
      }
      return unitsPromise;
    }

    function haversineKm(lat1, lng1, lat2, lng2) {
      var R = 6371;
      var dLat = ((lat2 - lat1) * Math.PI) / 180;
      var dLng = ((lng2 - lng1) * Math.PI) / 180;
      var a =
        Math.sin(dLat / 2) ** 2 +
        Math.cos((lat1 * Math.PI) / 180) * Math.cos((lat2 * Math.PI) / 180) * Math.sin(dLng / 2) ** 2;
      return R * 2 * Math.asin(Math.sqrt(a));
    }

    function normalize(s) {
      return s
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .toLowerCase();
    }

    // ---------- Preenchimento do campo "unidade" no form final ----------
    var unitInput = document.getElementById("unit");
    var unitSlugInput = document.getElementById("unitSlug");
    var lastConfirmedText = "";

    function setUnit(unit) {
      var label = unit.name + " — " + unit.city;
      unitInput.value = label;
      unitSlugInput.value = unit.slug || "";
      lastConfirmedText = label;
    }

    // Campo opcional: só fica preenchido se bater com uma unidade escolhida no
    // autocomplete. Texto digitado sem selecionar sugestão é limpo ao sair do
    // campo — sem alerta, sem travar o formulário, já que é opcional.
    function clearUnitIfUnconfirmed() {
      if (unitInput.value !== lastConfirmedText) {
        unitInput.value = "";
        unitSlugInput.value = "";
      }
    }
    unitInput.addEventListener("blur", function () {
      // atraso pra dar tempo do click numa sugestão (que chama setUnit) rodar
      // antes da checagem — clicar num botão da lista tira o foco do input.
      window.setTimeout(clearUnitIfUnconfirmed, 150);
    });
    // Rede de segurança: cobre o caso raro de enviar sem o input perder o foco.
    var leadFormEl = document.getElementById("leadForm");
    if (leadFormEl) leadFormEl.addEventListener("submit", clearUnitIfUnconfirmed, { capture: true });

    // ---------- Autocomplete ----------
    var unitSuggestions = document.getElementById("unitSuggestions");

    function renderSuggestions(matches) {
      if (!matches.length) {
        unitSuggestions.hidden = true;
        unitSuggestions.innerHTML = "";
        return;
      }
      unitSuggestions.innerHTML = matches
        .slice(0, 8)
        .map(
          function (u, i) {
            return '<button type="button" class="autocomplete-item" data-idx="' + i + '">' + u.name + " <span>— " + u.city + "</span></button>";
          }
        )
        .join("");
      unitSuggestions.hidden = false;

      unitSuggestions.querySelectorAll(".autocomplete-item").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var idx = Number(btn.dataset.idx);
          setUnit(matches[idx]);
          unitSuggestions.hidden = true;
        });
      });
    }

    var debounceTimer;
    if (unitInput) unitInput.addEventListener("input", function () {
      clearTimeout(debounceTimer);
      var query = normalize(unitInput.value.trim());
      if (query.length < 2) {
        unitSuggestions.hidden = true;
        return;
      }
      debounceTimer = setTimeout(async function () {
        var units = await loadUnits();
        var matches = units.filter(
          function (u) { return normalize(u.name).includes(query) || normalize(u.city || "").includes(query); }
        );
        renderSuggestions(matches);
      }, 150);
    });

    document.addEventListener("click", function (e) {
      if (!(e.target instanceof Node)) return;
      var unitField = document.getElementById("unitField");
      if (!unitField || !unitField.contains(e.target)) {
        unitSuggestions.hidden = true;
      }
    });

    // ---------- Localizador (seção #unidades) ----------
    var btnGeo = document.getElementById("btnGeo");
    var btnCep = document.getElementById("btnCep");
    var cepInput = document.getElementById("cepInput");
    var locatorMsg = document.getElementById("locatorMsg");
    var locatorResults = document.getElementById("locatorResults");

    // Só deixa dígito passar (max 8) e aplica a máscara 00000-000 enquanto digita.
    cepInput.addEventListener("input", function () {
      var digits = cepInput.value.replace(/\D/g, "").slice(0, 8);
      cepInput.value = digits.length > 5 ? digits.slice(0, 5) + "-" + digits.slice(5) : digits;
    });

    function setLocatorMsg(text, loading) {
      locatorMsg.textContent = text;
      locatorMsg.classList.toggle("is-loading", !!loading);
    }

    function renderLocatorResults(units, withDistance, originLat, originLng) {
      if (!units.length) {
        locatorResults.hidden = true;
        locatorResults.innerHTML = "";
        return;
      }
      locatorResults.innerHTML = units
        .slice(0, 3)
        .map(function (u, i) {
          var dist =
            withDistance && originLat != null && originLng != null && u.lat != null && u.lng != null
              ? '<span class="unit-distance">' + haversineKm(originLat, originLng, u.lat, u.lng).toFixed(1) + " km</span>"
              : "";
          return (
            '<div class="unit-result">' +
            '<div class="unit-result-head">' +
            "<h4>" + u.name + "</h4>" +
            dist +
            "</div>" +
            "<p>" + u.address + "</p>" +
            '<div class="unit-result-actions">' +
            (u.phone ? '<a href="https://wa.me/55' + u.phone.replace(/\D/g, "") + '" target="_blank" rel="noopener">WhatsApp</a>' : "") +
            '<button type="button" class="pick-unit" data-idx="' + i + '">Escolher esta unidade</button>' +
            "</div>" +
            "</div>"
          );
        })
        .join("");
      locatorResults.hidden = false;

      locatorResults.querySelectorAll(".pick-unit").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var idx = Number(btn.dataset.idx);
          setUnit(units[idx]);
          setLocatorMsg("Unidade selecionada: " + units[idx].name + ". Role até o final da página pra se matricular.");
          var locatorCta = document.getElementById("locatorCta");
          if (locatorCta) locatorCta.textContent = "Quero me matricular";
        });
      });
    }

    if (btnGeo) btnGeo.addEventListener("click", function () {
      if (!navigator.geolocation) {
        setLocatorMsg("Seu navegador não suporta localização automática. Tente digitar seu CEP.");
        return;
      }
      setLocatorMsg("Buscando sua localização...", true);
      navigator.geolocation.getCurrentPosition(
        async function (pos) {
          var latitude = pos.coords.latitude;
          var longitude = pos.coords.longitude;
          var units = (await loadUnits()).filter(function (u) { return u.lat != null && u.lng != null; });
          var sorted = units
            .map(function (u) { return { u: u, d: haversineKm(latitude, longitude, u.lat, u.lng) }; })
            .sort(function (a, b) { return a.d - b.d; })
            .map(function (x) { return x.u; });
          setLocatorMsg(
            sorted.length
              ? "Unidades mais próximas de você:"
              : "Não encontramos unidades próximas com dados de localização."
          );
          renderLocatorResults(sorted, true, latitude, longitude);
        },
        function () {
          setLocatorMsg("Não conseguimos acessar sua localização. Tente digitar seu CEP.");
        },
        { timeout: 8000 }
      );
    });

    if (btnCep) btnCep.addEventListener("click", async function () {
      var cep = cepInput.value.replace(/\D/g, "");
      if (cep.length !== 8) {
        setLocatorMsg("Digite um CEP válido (8 dígitos).");
        return;
      }
      setLocatorMsg("Buscando...", true);
      try {
        var res = await fetch("https://brasilapi.com.br/api/cep/v2/" + cep);
        if (!res.ok) throw new Error("CEP não encontrado");
        var data = await res.json();
        var lat = data && data.location && data.location.coordinates && data.location.coordinates.latitude;
        var lng = data && data.location && data.location.coordinates && data.location.coordinates.longitude;
        var units = await loadUnits();

        if (lat && lng) {
          var withCoords = units.filter(function (u) { return u.lat != null && u.lng != null; });
          var sorted = withCoords
            .map(function (u) { return { u: u, d: haversineKm(Number(lat), Number(lng), u.lat, u.lng) }; })
            .sort(function (a, b) { return a.d - b.d; })
            .map(function (x) { return x.u; });
          setLocatorMsg("Unidades mais próximas do seu CEP:");
          renderLocatorResults(sorted, true, Number(lat), Number(lng));
        } else {
          var city = normalize((data && data.city) || "");
          var sameCity = units.filter(function (u) { return normalize(u.city || "") === city; });
          setLocatorMsg(
            sameCity.length
              ? "Unidades em " + (data && data.city) + ":"
              : "Não encontramos unidades na cidade desse CEP."
          );
          renderLocatorResults(sameCity, false);
        }
      } catch (err) {
        setLocatorMsg("Não encontramos esse CEP. Confira e tente de novo.");
        locatorResults.hidden = true;
      }
    });
  })();
</script>

<script is:inline>
  // Saídas "leads_api_url" (primária) e "leads_api_url_secondary" do Terraform.
  // "unit" é opcional: a Lambda (lambda/leads.py) vai deixar de exigi-lo.
  (function () {
    var PRIMARY_API = "https://azgerdpbbf.execute-api.us-east-1.amazonaws.com/lead";
    var SECONDARY_API = "https://d6vyxkv0ue.execute-api.sa-east-1.amazonaws.com/lead";

    var form = document.getElementById("leadForm");
    var btn = document.getElementById("submitBtn");
    var nameInput = document.getElementById("name");
    var emailInput = document.getElementById("email");
    var phoneInput = document.getElementById("phone");

    // ---------- Máscara de telefone: (11) 99999-9999 / (11) 9999-9999 ----------
    function formatPhoneBR(raw) {
      var digits = raw.replace(/\D/g, "").slice(0, 11);
      var len = digits.length;
      if (len === 0) return "";
      if (len <= 2) return "(" + digits;
      if (len <= 6) return "(" + digits.slice(0, 2) + ") " + digits.slice(2);
      if (len <= 10) return "(" + digits.slice(0, 2) + ") " + digits.slice(2, 6) + "-" + digits.slice(6);
      return "(" + digits.slice(0, 2) + ") " + digits.slice(2, 7) + "-" + digits.slice(7);
    }
    phoneInput.addEventListener("input", function () {
      phoneInput.value = formatPhoneBR(phoneInput.value);
    });

    // ---------- Alerta fancy (valida campo a campo e avisa de sucesso) ----------
    var formAlert = document.getElementById("formAlert");
    var formAlertBox = document.getElementById("formAlertBox");
    var formAlertIcon = document.getElementById("formAlertIcon");
    var formAlertTitle = document.getElementById("formAlertTitle");
    var formAlertMsg = document.getElementById("formAlertMsg");
    var formAlertOk = document.getElementById("formAlertOk");

    var alertFocusTarget = null;

    function showFormAlert(kind, title, message, focusEl, okLabel) {
      focusEl = focusEl || null;
      okLabel = okLabel || "Entendi";
      formAlertBox.classList.toggle("success", kind === "success");
      formAlertIcon.textContent = kind === "success" ? "✓" : "!";
      formAlertTitle.textContent = title;
      formAlertMsg.textContent = message;
      formAlertOk.textContent = okLabel;
      alertFocusTarget = focusEl;
      formAlert.classList.add("open");
      formAlert.setAttribute("aria-hidden", "false");
      formAlert.removeAttribute("inert");
      document.body.style.overflow = "hidden";
      formAlertOk.focus();
    }

    function closeFormAlert() {
      formAlert.classList.remove("open");
      formAlert.setAttribute("aria-hidden", "true");
      formAlert.setAttribute("inert", "");
      document.body.style.overflow = "";
      var target = alertFocusTarget;
      alertFocusTarget = null;
      if (target) {
        // espera a transição de fechar (0.3s) terminar antes de levar o
        // cursor pro campo, senão o foco rola a página no meio da animação.
        setTimeout(function () { target.focus(); }, 280);
      }
    }
    formAlertOk.addEventListener("click", closeFormAlert);

    function fieldErrorMessage(input) {
      if (input === nameInput) {
        return input.validity.valueMissing
          ? "Conta pra gente seu nome completo pra continuar."
          : "Digite seu nome completo (pelo menos 2 letras).";
      }
      if (input === emailInput) {
        return input.validity.valueMissing
          ? "Informe seu melhor e-mail pra gente entrar em contato."
          : "Esse e-mail não parece válido — confira e tente de novo.";
      }
      if (input === phoneInput) {
        return input.validity.valueMissing
          ? "Informe um telefone com DDD pra gente te chamar."
          : "Esse telefone não ficou completo — confira o DDD e o número.";
      }
      return "Confira esse campo e tente de novo.";
    }

    async function postLead(url, payload, timeoutMs) {
      timeoutMs = timeoutMs || 4000;
      var controller = new AbortController();
      var timer = setTimeout(function () { controller.abort(); }, timeoutMs);
      try {
        var res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        return res;
      } finally {
        clearTimeout(timer);
      }
    }

    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      var requiredInputs = [nameInput, emailInput, phoneInput];
      for (var i = 0; i < requiredInputs.length; i++) {
        var input = requiredInputs[i];
        if (!input.checkValidity()) {
          showFormAlert("error", "Confira esse campo", fieldErrorMessage(input), input);
          return;
        }
      }

      var payload = {
        name: nameInput.value.trim(),
        email: emailInput.value.trim(),
        phone: phoneInput.value.trim(),
        unit: form.elements.namedItem("unit").value.trim(),
        unit_slug: form.elements.namedItem("unit_slug").value.trim(),
        campaign: form.elements.namedItem("campaign").value,
      };

      btn.disabled = true;
      btn.textContent = "Enviando...";

      var res, usedFallback = false;
      try {
        res = await postLead(PRIMARY_API, payload);
      } catch (primaryErr) {
        // Região primária falhou ou não respondeu a tempo: tenta a secundária.
        console.warn("Região primária indisponível, tentando failover:", primaryErr);
        usedFallback = true;
        try {
          res = await postLead(SECONDARY_API, payload);
        } catch (secondaryErr) {
          showFormAlert("error", "Não conseguimos enviar", "Erro de conexão em ambas as regiões. Tente novamente em instantes.");
          btn.disabled = false;
          btn.textContent = "Quero minha vaga";
          return;
        }
      }

      try {
        var data = await res.json();
        if (res.ok) {
          showFormAlert(
            "success",
            "Recebemos sua solicitação!",
            usedFallback
              ? "Obrigado pelo contato! Seus dados chegaram via nossa região de contingência — em breve um consultor Wizard fala com você."
              : "Obrigado pelo contato! Em breve um consultor Wizard vai falar com você.",
            null,
            "Fechar"
          );
          form.reset();
        } else {
          showFormAlert(
            "error",
            "Não foi possível enviar",
            (data.details && data.details.join(", ")) || "Confira os dados e tente de novo."
          );
        }
      } catch (err) {
        showFormAlert("error", "Erro de conexão", "Tente novamente em instantes.");
      } finally {
        btn.disabled = false;
        btn.textContent = "Quero minha vaga";
      }
    });
  })();
  </script>
</Layout>
