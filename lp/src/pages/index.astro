---
import Layout from '../layouts/LayoutProposta.astro';
import LogoMark from '../components/LogoMark.astro';
import BrumaLogo from '../components/BrumaLogo.astro';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/photo-hero.png';
import appPhoto from '../assets/hero-photo.jpg';
import modalidadesPhoto from '../assets/photo-modalidades.jpg';
import certificacaoPhoto from '../assets/photo-certificacao.jpg';
import logoPearsonWhite from '../assets/logo-pearson-white.webp';
---

<Layout>
  <header class="site-header">
    <div class="wrap header-row">
      <a class="logo" href="#top">
        <LogoMark />
      </a>
      <nav class="nav-desktop" aria-label="Navegação principal">
        <span class="nav-pill" id="navPill" aria-hidden="true"></span>
        <a href="#unidades">Unidades</a>
        <a href="#app-wizme">Diferenciais</a>
        <a href="#faq">FAQ</a>
        <a class="btn btn-primary btn-sm" href="#form-card">Quero minha vaga</a>
      </nav>
      <button class="nav-toggle" id="navToggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="navMobile">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <div class="nav-overlay" id="navOverlay"></div>
  <aside class="nav-mobile" id="navMobile" aria-label="Menu">
    <button class="nav-close" id="navClose" aria-label="Fechar menu">&times;</button>
    <div class="nav-mobile-logo"><LogoMark class="logo-mark logo-mark-mobile" /></div>
    <nav class="nav-mobile-links">
      <a href="#unidades">Unidades</a>
      <a href="#app-wizme">Diferenciais</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a class="btn btn-primary nav-mobile-cta" href="#form-card">Quero minha vaga</a>
    <div class="nav-mobile-footer">
      <Image src={logoPearsonWhite} alt="Pearson" width={110} class="pearson-logo" />
      <p>Acompanhe nossas redes sociais:</p>
      <div class="social-row">
        <a href="https://www.facebook.com/wizard.oficial" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8.2h2.75l.41-3.2h-3.16V7.5c0-.93.26-1.56 1.59-1.56h1.7V3.1C15.98 3.07 15 3 13.85 3 11.44 3 9.8 4.46 9.8 7.2v2.4H7v3.2h2.8V21h3.7Z"/></svg>
        </a>
        <a href="https://www.instagram.com/wizardbrasil.oficial/" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="17.2" cy="6.8" r="1"/></svg>
        </a>
        <a href="https://www.youtube.com/c/WizardbyPearson" target="_blank" rel="noopener" aria-label="YouTube">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12s0-3.2-.4-4.7c-.24-.86-.9-1.53-1.76-1.77C18.3 5.1 12 5.1 12 5.1s-6.3 0-7.84.43c-.86.24-1.52.9-1.76 1.77C2 8.8 2 12 2 12s0 3.2.4 4.7c.24.86.9 1.5 1.76 1.75C5.7 18.9 12 18.9 12 18.9s6.3 0 7.84-.44c.86-.24 1.52-.9 1.76-1.76.4-1.5.4-4.7.4-4.7ZM10 15.2V8.8l5.5 3.2-5.5 3.2Z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/wizard" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.56V20h3.38V8.5ZM5.25 3c-1.15 0-1.9.76-1.9 1.76 0 .98.73 1.76 1.86 1.76h.02c1.17 0 1.9-.78 1.9-1.76C7.11 3.76 6.4 3 5.25 3ZM20.5 20h-3.38v-6.15c0-1.5-.54-2.52-1.88-2.52-1.03 0-1.64.7-1.91 1.36-.1.24-.12.57-.12.9V20H9.83s.05-10.36 0-11.5h3.38v1.63c.45-.7 1.25-1.68 3.04-1.68 2.22 0 3.88 1.45 3.88 4.56V20Z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@wizardbypearson" target="_blank" rel="noopener" aria-label="TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3h-3v12.4a2.6 2.6 0 1 1-1.9-2.5V9.4a5.9 5.9 0 1 0 4.9 5.8V9.1a6.8 6.8 0 0 0 4 1.3V7.3a3.9 3.9 0 0 1-4-4.3Z"/></svg>
        </a>
      </div>
    </div>
  </aside>

  <main>
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="eyebrow">Volta às Aulas 2027</span>
        <h1>Fale inglês com <span>confiança</span> no ano que começa</h1>
        <p class="lead">Garanta sua vaga na Wizard com condições exclusivas de Volta às Aulas. Aulas práticas, professores nativos e um método que já formou milhões de alunos no Brasil.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#form-card">Quero minha vaga</a>
          <a class="btn btn-ghost" href="#app-wizme">Ver benefícios</a>
        </div>
        <div class="stat-row" id="statRow">
          <div class="stat"><b class="counter" data-target="1200" data-prefix="+">0</b><span>unidades<br>no Brasil</span></div>
          <div class="stat"><b class="counter" data-target="40" data-prefix="+">0</b><span>anos de<br>experiência</span></div>
          <div class="stat"><b class="counter" data-target="8">0</b><span>idiomas<br>disponíveis</span></div>
        </div>
      </div>
      <div class="hero-visual">
        <Image src={heroPhoto} alt="Aluna sorrindo enquanto estuda com um tablet" width={520} height={620} class="hero-photo" loading="eager" fetchpriority="high" />
        <div class="discount-chip">
          <span class="num"><b class="counter" data-target="30" data-prefix="-" data-suffix="%">0</b></span>
          <span class="cap">na matrícula<br>por pouco<br>tempo</span>
        </div>
      </div>
    </div>
  </section>

  <section class="locator" id="unidades">
    <div class="wrap">
      <span class="kicker">Encontre sua unidade</span>
      <h2>Tem uma Wizard perto de você</h2>
      <p class="locator-intro">Mais de 1.200 unidades no Brasil — descubra a mais próxima usando sua localização ou o CEP, sem precisar procurar em uma lista gigante.</p>

      <div class="locator-box">
        <button class="btn btn-primary" id="btnGeo" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>
          Use sua localização
        </button>
        <span class="locator-or">ou digite seu CEP</span>
        <div class="locator-cep">
          <input type="text" id="cepInput" placeholder="00000-000" inputmode="numeric" maxlength="9" aria-label="CEP">
          <button class="btn btn-ghost-dark" id="btnCep" type="button">Buscar</button>
        </div>
      </div>

      <p class="locator-msg" id="locatorMsg" role="status"></p>
      <div class="locator-results" id="locatorResults" hidden></div>

      <a class="btn btn-primary locator-cta" id="locatorCta" href="#form-card">Já sei minha unidade, quero matricular</a>
    </div>
  </section>

  <section class="diff-section" id="app-wizme">
    <div class="wrap diff-grid">
      <div class="diff-photo-wrap">
        <Image src={appPhoto} alt="Aluno sorrindo enquanto pratica inglês pelo app da Wizard no celular" width={430} height={543} class="diff-photo diff-photo-tall" />
      </div>
      <div>
        <span class="kicker">App Wiz.me</span>
        <h2>Pratique todo santo dia, mesmo fora da sala</h2>
        <p>O aplicativo da Wizard usa reconhecimento de voz pra avaliar sua pronúncia na hora, funciona offline e sincroniza com o conteúdo das suas aulas.</p>
        <ul class="diff-list">
          <li><span class="tick">✓</span> Correção de pronúncia em tempo real</li>
          <li><span class="tick">✓</span> Funciona offline — pratique onde estiver</li>
          <li><span class="tick">✓</span> Cobre fala, escuta, leitura e escrita</li>
        </ul>
        <p class="diff-objection">"Não vou ter disciplina pra praticar sozinho." É exatamente pra isso que o app existe: atividades curtas e lembretes, sem depender só da sua memória.</p>
        <a class="scroll-next" href="#modalidades">Ver próximo diferencial ↓</a>
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="wrap">
      <a class="btn btn-primary btn-glow" href="#form-card">Quero conversar com a equipe</a>
    </div>
  </div>

  <section class="diff-section diff-alt" id="modalidades">
    <div class="wrap diff-grid">
      <div class="diff-photo-wrap">
        <Image src={modalidadesPhoto} alt="Professora orientando um grupo de alunos com notebooks em sala" width={640} height={640} quality={68} class="diff-photo" />
      </div>
      <div>
        <span class="kicker">Como você quer aprender</span>
        <h2>Presencial, no seu ritmo ou 100% online</h2>
        <p>A mesma metodologia Wizard, em três formatos — você escolhe o que combina com sua rotina.</p>
        <ul class="diff-list diff-list-table">
          <li><span class="tick">✓</span> <b>Connections:</b> <span>turma, professor conduz o ritmo, ninguém fica pra trás</span></li>
          <li><span class="tick">✓</span> <b>Interactive:</b> <span>ritmo definido por você, com mentor e tecnologia de apoio</span></li>
          <li><span class="tick">✓</span> <b>Wizard ON:</b> <span>100% online e ao vivo, com professores dedicados</span></li>
        </ul>
        <p class="diff-objection">"Não sei qual formato combina comigo." Um consultor te ajuda a escolher — e você pode trocar de modalidade depois, se precisar.</p>
        <a class="scroll-next" href="#certificacao">Ver próximo diferencial ↓</a>
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="wrap">
      <a class="btn btn-primary btn-glow" href="#form-card">Quero conversar com a equipe</a>
    </div>
  </div>

  <section class="diff-section" id="certificacao">
    <div class="wrap diff-grid">
      <div class="diff-photo-wrap">
        <Image src={certificacaoPhoto} alt="Professor confiante sorrindo em sala de aula" width={640} height={640} class="diff-photo" />
      </div>
      <div>
        <span class="kicker">Certificação internacional</span>
        <h2>Um diploma que vale fora da sala de aula</h2>
        <p>Exames Pearson (PEIC, Versant, Benchmark), baseados nos padrões internacionais GSE e CEFR — aceitos por universidades, empresas e processos de visto ao redor do mundo.</p>
        <ul class="diff-list">
          <li><span class="tick">✓</span> Avalia as 4 habilidades: fala, escuta, leitura e escrita</li>
          <li><span class="tick">✓</span> Reconhecimento internacional, da Pearson</li>
          <li><span class="tick">✓</span> Alunos Wizard têm oportunidades de certificação ao longo do curso</li>
        </ul>
        <p class="diff-objection">"Isso vale alguma coisa formalmente?" Sim — é reconhecido por instituições e empregadores fora do Brasil, não só um certificado de curso.</p>
        <a class="scroll-next" href="#faq">Ver dúvidas frequentes ↓</a>
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="wrap">
      <a class="btn btn-primary btn-glow" href="#form-card">Quero conversar com a equipe</a>
    </div>
  </div>

  <section class="faq" id="faq">
    <div class="wrap">
      <span class="kicker">Dúvidas frequentes</span>
      <h2>Ainda com alguma pergunta?</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Quais são as diferenças entre as modalidades de ensino?</summary>
          <p>No modelo <b>Connections</b> você estuda em turma, com o professor conduzindo o ritmo da aula — ideal para quem gosta de aprender interagindo com outras pessoas. No <b>Interactive</b> o ritmo é definido por você, com acompanhamento individual do professor e apoio de tecnologia. Também há o <b>Wizard ON</b>, 100% online e ao vivo, para quem precisa de flexibilidade de horário.</p>
        </details>
        <details class="faq-item">
          <summary>Como funciona o desconto de matrícula?</summary>
          <p>A condição de 30% de desconto é válida por tempo limitado para novas matrículas e pode variar conforme a unidade escolhida. Um consultor confirma o valor exato e as condições de pagamento para você durante o contato.</p>
        </details>
        <details class="faq-item">
          <summary>O material didático está incluso no curso?</summary>
          <p>Sim. O conteúdo é desenvolvido pela própria Wizard e acompanha sua jornada em todas as modalidades, além de se integrar ao aplicativo Wiz.me para prática fora da sala de aula.</p>
        </details>
        <details class="faq-item">
          <summary>Preciso já saber inglês para começar?</summary>
          <p>Não. As turmas são organizadas por nível, incluindo turmas para quem está começando do zero. Um teste de nivelamento gratuito indica o ponto ideal para você iniciar.</p>
        </details>
        <details class="faq-item">
          <summary>Como funciona a aula experimental gratuita?</summary>
          <p>Ao preencher o formulário, um consultor Wizard agenda uma aula experimental sem custo na unidade de sua preferência, para você conhecer o método antes de decidir.</p>
        </details>
        <details class="faq-item">
          <summary>As aulas são só presenciais?</summary>
          <p>Não. Além das modalidades presenciais (Connections e Interactive), a Wizard também oferece o Wizard ON, com aulas ao vivo 100% online — você escolhe o formato que faz mais sentido pra sua rotina.</p>
        </details>
        <details class="faq-item">
          <summary>Não encontrei minha dúvida. Com quem falo?</summary>
          <p>Preencha o formulário abaixo com seu contato — um consultor Wizard responde qualquer dúvida antes de você decidir se matricular.</p>
        </details>
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="wrap">
      <a class="btn btn-primary btn-glow" href="#form-card">Quero conversar com a equipe</a>
    </div>
  </div>

  <section class="form-section" id="form">
    <div class="wrap">
      <div class="form-copy">
        <span class="kicker">Matrícula Volta às Aulas</span>
        <h2>Peça uma ligação da nossa equipe</h2>
        <p>Preencha seus dados e um consultor Wizard entra em contato para te ajudar a escolher a turma ideal, com a condição especial de Volta às Aulas.</p>
        <ul>
          <li><span class="tick">✓</span> Resposta em até 1 dia útil</li>
          <li><span class="tick">✓</span> Aula experimental gratuita</li>
          <li><span class="tick">✓</span> Condições especiais só para quem se inscrever agora</li>
        </ul>
        <p class="privacy-note">Ao enviar, você concorda em ser contatado pela Wizard sobre matrículas e promoções. Seus dados são tratados com segurança em infraestrutura AWS resiliente e criptografada.</p>
      </div>

      <div class="card-form" id="form-card">
        <h3>Garanta sua condição especial</h3>
        <p class="sub">Leva menos de 1 minuto <span class="required-note">* Campos obrigatórios</span></p>

        <form
          id="leadForm"
          novalidate
          toolname="requestWizardCallback"
          tooldescription="Envia um pedido de contato para a Wizard: um consultor liga de volta para ajudar a pessoa a se matricular na promoção Volta às Aulas."
        >
          <div class="field">
            <label for="name"><span class="required-mark">*</span> Nome completo:</label>
            <input
              id="name"
              name="name"
              type="text"
              placeholder="Como podemos te chamar?"
              required
              minlength="2"
              toolparamdescription="Nome completo da pessoa interessada, com pelo menos 2 caracteres."
            >
          </div>
          <div class="field">
            <label for="email"><span class="required-mark">*</span> Seu melhor E-mail:</label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="seuemail@exemplo.com"
              required
              toolparamdescription="Endereco de e-mail valido da pessoa, usado para contato sobre a matricula."
            >
          </div>
          <div class="field">
            <label for="phone"><span class="required-mark">*</span> Telefone / WhatsApp:</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              placeholder="(11) 99999-9999"
              required
              maxlength="15"
              pattern="\(\d{2}\) \d{4,5}-\d{4}"
              inputmode="numeric"
              toolparamdescription="Telefone/WhatsApp brasileiro com DDD, no formato (11) 99999-9999."
            >
          </div>
          <div class="field autocomplete" id="unitField">
            <label for="unit">Unidade de interesse:</label>
            <input
              id="unit"
              name="unit"
              type="text"
              placeholder="Digite o nome da unidade ou a cidade"
              autocomplete="off"
              minlength="2"
              toolparamdescription="Nome da unidade Wizard ou cidade de interesse (ex.: 'Wizard Paulista' ou 'São Paulo'). Opcional — se preenchido, deve corresponder a uma unidade real da lista de sugestões."
            >
            <div class="autocomplete-list" id="unitSuggestions" hidden></div>
          </div>
          <input type="hidden" name="unit_slug" id="unitSlug" value="">
          <input type="hidden" name="campaign" value="volta-as-aulas">

          <button class="btn btn-primary submit-btn" type="submit" id="submitBtn">Quero minha vaga</button>
        </form>
      </div>
    </div>
  </section>

  <div class="alert-overlay" id="formAlert" aria-hidden="true" inert>
    <div class="alert-box" id="formAlertBox" role="alertdialog" aria-modal="true" aria-labelledby="formAlertTitle" aria-describedby="formAlertMsg">
      <div class="alert-icon" id="formAlertIcon" aria-hidden="true">!</div>
      <h4 id="formAlertTitle">Aviso</h4>
      <p id="formAlertMsg"></p>
      <button type="button" class="btn btn-primary alert-ok" id="formAlertOk">Entendi</button>
    </div>
  </div>
  </main>

  <footer>
    <div class="wrap">
      <div class="footer-brand">
        <BrumaLogo class="footer-logo" />
        <span class="badge-live">Equipe BRUMA</span>
      </div>
      <p>Wizard — Landing page de teste (Case B, Hackathon Future Builders). Não é o site oficial.</p>
      <p class="footer-credits">Hackathon Future Builders 2026, realizado pela Escola da Nuvem em parceria com a AWS — a Wizard participa como avaliadora do case.</p>
      <p class="footer-tech">Infraestrutura resiliente na AWS: CloudFront, WAF, Route 53 com failover regional e S3 multi-região.</p>
    </div>
  </footer>

  <script is:inline>
  (function () {
    var navToggle = document.getElementById("navToggle");
    var navClose = document.getElementById("navClose");
    var navMobile = document.getElementById("navMobile");
    var navOverlay = document.getElementById("navOverlay");

    // Logo do menu mobile: mesmo pulso letra a letra do hover do logo
    // principal (".logo-active", ver CSS), disparado uma unica vez quando o
    // menu surge — nao o fade/zoom de entrada, que so faz sentido no
    // primeiro load da pagina. So precisa dar toggle na classe: cada vez
    // que o menu fecha ela sai, entao a proxima abertura sempre conta como
    // uma aplicacao nova da regra (o navegador reinicia a animacao sozinho,
    // sem precisar do truque de forcar reflow).
    var navMobileLogo = navMobile.querySelector(".nav-mobile-logo");

    function openNav() {
      navMobile.classList.add("open");
      navOverlay.classList.add("open");
      navToggle.setAttribute("aria-expanded", "true");
      if (navMobileLogo) navMobileLogo.classList.add("logo-active");
    }

    function closeNav() {
      navMobile.classList.remove("open");
      navOverlay.classList.remove("open");
      navToggle.setAttribute("aria-expanded", "false");
      if (navMobileLogo) navMobileLogo.classList.remove("logo-active");
    }

    navToggle.addEventListener("click", openNav);
    navClose.addEventListener("click", closeNav);
    navOverlay.addEventListener("click", closeNav);
    navMobile.querySelectorAll("a").forEach(function (link) { link.addEventListener("click", closeNav); });

    // Se a janela voltar pro tamanho desktop com o menu mobile aberto, fecha
    // (o header desktop já mostra os links, não faz sentido manter o overlay).
    var desktopQuery = window.matchMedia("(min-width: 861px)");
    desktopQuery.addEventListener("change", function (e) {
      if (e.matches) closeNav();
    });

    // Efeito "luzes de cinema" no selo de desconto: no desktop o :hover do CSS
    // já resolve, mas :active não é confiável em toque (iOS só dispara em
    // elemento com handler de touch/click), então alterna a classe no touch.
    var heroVisual = document.querySelector(".hero-visual");
    if (heroVisual) {
      heroVisual.addEventListener("touchstart", function () { heroVisual.classList.add("marquee-active"); }, { passive: true });
      var clearMarquee = function () { heroVisual.classList.remove("marquee-active"); };
      heroVisual.addEventListener("touchend", clearMarquee);
      heroVisual.addEventListener("touchcancel", clearMarquee);
    }

    // Mesma logica pro logo: em touch nao existe :hover, entao o "replay"
    // letra a letra so acontece de novo se a pessoa realmente pressionar
    // (touchstart/touchend), igual ao hover no desktop.
    var logoLink = document.querySelector(".logo");
    if (logoLink) {
      logoLink.addEventListener("touchstart", function () { logoLink.classList.add("logo-active"); }, { passive: true });
      var clearLogoActive = function () { logoLink.classList.remove("logo-active"); };
      logoLink.addEventListener("touchend", clearLogoActive);
      logoLink.addEventListener("touchcancel", clearLogoActive);
    }

    // Menu pilula (so existe no nav desktop — no mobile o <nav> some via
    // display:none e os links viram 0x0, entao os listeners abaixo nunca
    // disparam la, sem precisar de media query no JS).
    var navDesktop = document.querySelector(".nav-desktop");
    var navPill = document.getElementById("navPill");
    var navCta = navDesktop ? navDesktop.querySelector("a.btn") : null;
    if (navDesktop && navPill && navCta) {
      var navItems = Array.prototype.slice.call(navDesktop.querySelectorAll("a"));
      var movePill = function (el) {
        var navRect = navDesktop.getBoundingClientRect();
        var elRect = el.getBoundingClientRect();
        navPill.style.transform = "translateX(" + (elRect.left - navRect.left) + "px)";
        navPill.style.width = elRect.width + "px";
        var isCta = el === navCta;
        navPill.classList.toggle("is-cta", isCta);
        navPill.classList.toggle("is-link", !isCta);
        navItems.forEach(function (item) {
          item.classList.toggle("is-pilled", item === el);
        });
      };
      var goToCta = function () { movePill(navCta); };

      // Estado inicial: pilula ja nasce em cima do "Quero minha vaga", sem
      // deslizar. A transicao mora só na classe .pill-ready (ver CSS), que
      // entra depois de posicionar — evita o truque antigo de "desliga
      // transicao + le offsetHeight pra forcar reflow + religa", que o
      // PageSpeed acusa como reflow forcado. Um so requestAnimationFrame
      // ainda roda antes do primeiro layout natural da pagina (a leitura
      // de getBoundingClientRect force-a de qualquer jeito); o segundo rAF
      // aninhado so dispara depois que esse primeiro paint realmente
      // aconteceu, entao a leitura ali vem de um layout ja calculado.
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          goToCta();
          navPill.classList.add("pill-ready");
        });
      });

      // Todos os 4 itens (incluindo a CTA) disparam a pilula no hover —
      // se nao, mover o mouse de um link direto pro botao nao troca nada,
      // porque isso nao passa por um "mouseleave" do <nav> (o ponteiro
      // nunca saiu dele, so andou entre os filhos).
      navItems.forEach(function (item) {
        item.addEventListener("mouseenter", function () { movePill(item); });
        item.addEventListener("focus", function () { movePill(item); });
      });

      // Clicar num link de ancora (#faq, #unidades...) faz o navegador
      // mover o foco pro elemento de destino da rolagem assim que a pagina
      // desliza ate la — isso dispara um "focusout" do nav mesmo com o
      // mouse parado em cima do link clicado, e a pilula pulava pro CTA no
      // meio do clique (parecia um soluco/recarregamento). Rastreando se o
      // ponteiro esta mesmo sobre o nav, so reagimos ao focusout de
      // verdade (ex.: Tab saindo do menu pelo teclado).
      var isPointerOverNav = false;
      navDesktop.addEventListener("mouseenter", function () { isPointerOverNav = true; });
      navDesktop.addEventListener("mouseleave", function () {
        isPointerOverNav = false;
        goToCta();
      });
      navDesktop.addEventListener("focusout", function (e) {
        if (isPointerOverNav) return;
        if (!navDesktop.contains(e.relatedTarget)) goToCta();
      });
    }
  })();
</script>

<script is:inline>
  (function () {
    // Colapso animado do FAQ: <details> nativo abre/fecha instantaneo, sem
    // transicao possivel so em CSS (height:auto nao anima). Intercepta o
    // clique, mede a altura real do <p> e anima com a Web Animations API.
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) return;

    var items = document.querySelectorAll(".faq-item");
    items.forEach(function (item) {
      var summary = item.querySelector("summary");
      var body = item.querySelector("p");
      if (!summary || !body) return;
      var currentAnim = null;
      // Intencao logica separada de "item.open": o atributo so vira false
      // no FIM da animacao de fechar, entao usar "item.open" pra decidir a
      // direcao de um clique no meio dessa animacao acertaria errado.
      var isOpenState = false;

      var collapse = function () {
        var startH = body.offsetHeight;
        var startM = parseFloat(getComputedStyle(body).marginBottom) || 0;
        body.style.overflow = "hidden";
        currentAnim = body.animate(
          [
            { height: startH + "px", marginBottom: startM + "px", opacity: 1 },
            { height: "0px", marginBottom: "0px", opacity: 0 },
          ],
          { duration: 220, easing: "ease" }
        );
        currentAnim.onfinish = function () {
          item.open = false;
          body.style.removeProperty("height");
          body.style.removeProperty("margin-bottom");
          body.style.removeProperty("overflow");
          currentAnim = null;
        };
      };

      var expand = function () {
        item.open = true;
        var endH = body.offsetHeight;
        var endM = parseFloat(getComputedStyle(body).marginBottom) || 0;
        body.style.overflow = "hidden";
        currentAnim = body.animate(
          [
            { height: "0px", marginBottom: "0px", opacity: 0 },
            { height: endH + "px", marginBottom: endM + "px", opacity: 1 },
          ],
          { duration: 220, easing: "ease" }
        );
        currentAnim.onfinish = function () {
          body.style.removeProperty("height");
          body.style.removeProperty("margin-bottom");
          body.style.removeProperty("overflow");
          currentAnim = null;
        };
      };

      summary.addEventListener("click", function (e) {
        e.preventDefault();
        if (currentAnim) currentAnim.cancel();
        isOpenState = !isOpenState;
        item.classList.toggle("is-open", isOpenState);
        if (isOpenState) {
          expand();
        } else {
          collapse();
        }
      });
    });
  })();
</script>

<script is:inline>
  // Contador animado das estatísticas do hero e do chip de desconto: conta de
  // 0 até o alvo assim que a página carrega (o hero já aparece na tela sem
  // precisar rolar, então dispara direto — nada de esperar IntersectionObserver
  // aqui, senão fica zerado até o usuário rolar).
  (function () {
    var counters = document.querySelectorAll(".counter");

    function animateCounter(el) {
      var target = Number(el.dataset.target || "0");
      var prefix = el.dataset.prefix || "";
      var suffix = el.dataset.suffix || "";
      var duration = 1200;
      var start = performance.now();

      function tick(now) {
        var progress = Math.min((now - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var value = Math.round(target * eased);
        el.textContent = prefix + value.toLocaleString("pt-BR") + suffix;
        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          el.classList.add("pop");
          setTimeout(function () { el.classList.remove("pop"); }, 250);
        }
      }
      requestAnimationFrame(tick);
    }

    counters.forEach(function (el) { animateCounter(el); });
  })();
</script>

<script is:inline>
  // Unidades: dataset estático (só SP, ver lp/scripts/refresh-units.mjs), gerado
  // no deploy a partir da API da Wizard. Localizador e autocomplete do form
  // rodam 100% no navegador a partir desse JSON — nunca chamam a API da Wizard
  // em produção (só o CEP é geocodificado, via BrasilAPI, que não é da Wizard).
  (function () {
    // Script inline (is:inline) pra tirar essa cadeia do preload scanner —
    // por isso "/" fixo em vez de import.meta.env.BASE_URL (só funciona em
    // script processado pelo Vite/Astro). O projeto não define "base" no
    // astro.config.mjs, então BASE_URL sempre resolveria pra "/" mesmo.
    var BASE_URL = "/";

    var unitsPromise = null;
    function loadUnits() {
      if (!unitsPromise) {
        unitsPromise = fetch(BASE_URL + "data/units-sp.json")
          .then(function (r) { return r.json(); })
          .then(function (data) { return data.units; })
          .catch(function () { return []; });
      }
      return unitsPromise;
    }

    function haversineKm(lat1, lng1, lat2, lng2) {
      var R = 6371;
      var dLat = ((lat2 - lat1) * Math.PI) / 180;
      var dLng = ((lng2 - lng1) * Math.PI) / 180;
      var a =
        Math.sin(dLat / 2) ** 2 +
        Math.cos((lat1 * Math.PI) / 180) * Math.cos((lat2 * Math.PI) / 180) * Math.sin(dLng / 2) ** 2;
      return R * 2 * Math.asin(Math.sqrt(a));
    }

    function normalize(s) {
      return s
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .toLowerCase();
    }

    // ---------- Preenchimento do campo "unidade" no form final ----------
    var unitInput = document.getElementById("unit");
    var unitSlugInput = document.getElementById("unitSlug");
    var lastConfirmedText = "";

    function setUnit(unit) {
      var label = unit.name + " — " + unit.city;
      unitInput.value = label;
      unitSlugInput.value = unit.slug || "";
      lastConfirmedText = label;
    }

    // Campo opcional: só fica preenchido se bater com uma unidade escolhida no
    // autocomplete. Texto digitado sem selecionar sugestão é limpo ao sair do
    // campo — sem alerta, sem travar o formulário, já que é opcional.
    function clearUnitIfUnconfirmed() {
      if (unitInput.value !== lastConfirmedText) {
        unitInput.value = "";
        unitSlugInput.value = "";
      }
    }
    unitInput.addEventListener("blur", function () {
      // atraso pra dar tempo do click numa sugestão (que chama setUnit) rodar
      // antes da checagem — clicar num botão da lista tira o foco do input.
      window.setTimeout(clearUnitIfUnconfirmed, 150);
    });
    // Rede de segurança: cobre o caso raro de enviar sem o input perder o foco.
    var leadFormEl = document.getElementById("leadForm");
    if (leadFormEl) leadFormEl.addEventListener("submit", clearUnitIfUnconfirmed, { capture: true });

    // ---------- Autocomplete ----------
    var unitSuggestions = document.getElementById("unitSuggestions");

    function renderSuggestions(matches) {
      if (!matches.length) {
        unitSuggestions.hidden = true;
        unitSuggestions.innerHTML = "";
        return;
      }
      unitSuggestions.innerHTML = matches
        .slice(0, 8)
        .map(
          function (u, i) {
            return '<button type="button" class="autocomplete-item" data-idx="' + i + '">' + u.name + " <span>— " + u.city + "</span></button>";
          }
        )
        .join("");
      unitSuggestions.hidden = false;

      unitSuggestions.querySelectorAll(".autocomplete-item").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var idx = Number(btn.dataset.idx);
          setUnit(matches[idx]);
          unitSuggestions.hidden = true;
        });
      });
    }

    var debounceTimer;
    if (unitInput) unitInput.addEventListener("input", function () {
      clearTimeout(debounceTimer);
      var query = normalize(unitInput.value.trim());
      if (query.length < 2) {
        unitSuggestions.hidden = true;
        return;
      }
      debounceTimer = setTimeout(async function () {
        var units = await loadUnits();
        var matches = units.filter(
          function (u) { return normalize(u.name).includes(query) || normalize(u.city || "").includes(query); }
        );
        renderSuggestions(matches);
      }, 150);
    });

    document.addEventListener("click", function (e) {
      if (!(e.target instanceof Node)) return;
      var unitField = document.getElementById("unitField");
      if (!unitField || !unitField.contains(e.target)) {
        unitSuggestions.hidden = true;
      }
    });

    // ---------- Localizador (seção #unidades) ----------
    var btnGeo = document.getElementById("btnGeo");
    var btnCep = document.getElementById("btnCep");
    var cepInput = document.getElementById("cepInput");
    var locatorMsg = document.getElementById("locatorMsg");
    var locatorResults = document.getElementById("locatorResults");

    // Só deixa dígito passar (max 8) e aplica a máscara 00000-000 enquanto digita.
    cepInput.addEventListener("input", function () {
      var digits = cepInput.value.replace(/\D/g, "").slice(0, 8);
      cepInput.value = digits.length > 5 ? digits.slice(0, 5) + "-" + digits.slice(5) : digits;
    });

    function setLocatorMsg(text, loading) {
      locatorMsg.textContent = text;
      locatorMsg.classList.toggle("is-loading", !!loading);
    }

    function renderLocatorResults(units, withDistance, originLat, originLng) {
      if (!units.length) {
        locatorResults.hidden = true;
        locatorResults.innerHTML = "";
        return;
      }
      locatorResults.innerHTML = units
        .slice(0, 3)
        .map(function (u, i) {
          var dist =
            withDistance && originLat != null && originLng != null && u.lat != null && u.lng != null
              ? '<span class="unit-distance">' + haversineKm(originLat, originLng, u.lat, u.lng).toFixed(1) + " km</span>"
              : "";
          return (
            '<div class="unit-result">' +
            '<div class="unit-result-head">' +
            "<h4>" + u.name + "</h4>" +
            dist +
            "</div>" +
            "<p>" + u.address + "</p>" +
            '<div class="unit-result-actions">' +
            (u.phone ? '<a href="https://wa.me/55' + u.phone.replace(/\D/g, "") + '" target="_blank" rel="noopener">WhatsApp</a>' : "") +
            '<button type="button" class="pick-unit" data-idx="' + i + '">Escolher esta unidade</button>' +
            "</div>" +
            "</div>"
          );
        })
        .join("");
      locatorResults.hidden = false;

      locatorResults.querySelectorAll(".pick-unit").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var idx = Number(btn.dataset.idx);
          setUnit(units[idx]);
          setLocatorMsg("Unidade selecionada: " + units[idx].name + ". Role até o final da página pra se matricular.");
          var locatorCta = document.getElementById("locatorCta");
          if (locatorCta) locatorCta.textContent = "Quero me matricular";
        });
      });
    }

    if (btnGeo) btnGeo.addEventListener("click", function () {
      if (!navigator.geolocation) {
        setLocatorMsg("Seu navegador não suporta localização automática. Tente digitar seu CEP.");
        return;
      }
      setLocatorMsg("Buscando sua localização...", true);
      navigator.geolocation.getCurrentPosition(
        async function (pos) {
          var latitude = pos.coords.latitude;
          var longitude = pos.coords.longitude;
          var units = (await loadUnits()).filter(function (u) { return u.lat != null && u.lng != null; });
          var sorted = units
            .map(function (u) { return { u: u, d: haversineKm(latitude, longitude, u.lat, u.lng) }; })
            .sort(function (a, b) { return a.d - b.d; })
            .map(function (x) { return x.u; });
          setLocatorMsg(
            sorted.length
              ? "Unidades mais próximas de você:"
              : "Não encontramos unidades próximas com dados de localização."
          );
          renderLocatorResults(sorted, true, latitude, longitude);
        },
        function () {
          setLocatorMsg("Não conseguimos acessar sua localização. Tente digitar seu CEP.");
        },
        { timeout: 8000 }
      );
    });

    if (btnCep) btnCep.addEventListener("click", async function () {
      var cep = cepInput.value.replace(/\D/g, "");
      if (cep.length !== 8) {
        setLocatorMsg("Digite um CEP válido (8 dígitos).");
        return;
      }
      setLocatorMsg("Buscando...", true);
      try {
        var res = await fetch("https://brasilapi.com.br/api/cep/v2/" + cep);
        if (!res.ok) throw new Error("CEP não encontrado");
        var data = await res.json();
        var lat = data && data.location && data.location.coordinates && data.location.coordinates.latitude;
        var lng = data && data.location && data.location.coordinates && data.location.coordinates.longitude;
        var units = await loadUnits();

        if (lat && lng) {
          var withCoords = units.filter(function (u) { return u.lat != null && u.lng != null; });
          var sorted = withCoords
            .map(function (u) { return { u: u, d: haversineKm(Number(lat), Number(lng), u.lat, u.lng) }; })
            .sort(function (a, b) { return a.d - b.d; })
            .map(function (x) { return x.u; });
          setLocatorMsg("Unidades mais próximas do seu CEP:");
          renderLocatorResults(sorted, true, Number(lat), Number(lng));
        } else {
          var city = normalize((data && data.city) || "");
          var sameCity = units.filter(function (u) { return normalize(u.city || "") === city; });
          setLocatorMsg(
            sameCity.length
              ? "Unidades em " + (data && data.city) + ":"
              : "Não encontramos unidades na cidade desse CEP."
          );
          renderLocatorResults(sameCity, false);
        }
      } catch (err) {
        setLocatorMsg("Não encontramos esse CEP. Confira e tente de novo.");
        locatorResults.hidden = true;
      }
    });
  })();
</script>

<script is:inline>
  // "/lead" é um path relativo ao proprio dominio da LP, de proposito: o
  // CloudFront ja tem um behavior pra "/lead" apontando pro API Gateway
  // primario, protegido pelo WAF (cloudfront.tf). Chamar a URL da API
  // diretamente (execute-api.amazonaws.com) contornaria esse WAF - por
  // isso nao existe mais uma constante com a URL absoluta aqui.
  //
  // Sem fallback pra regiao secundaria: a API secundaria nao tem behavior
  // no CloudFront (nao esta atras do WAF), entao chama-la direto do
  // navegador seria o mesmo problema de seguranca. Se "/lead" falhar, so
  // avisamos a pessoa pra tentar de novo - sem contornar a protecao.
  // "unit" é opcional: a Lambda (lambda/leads.py) já não exige mais.
  (function () {
    var LEAD_ENDPOINT = "/lead";

    var form = document.getElementById("leadForm");
    var btn = document.getElementById("submitBtn");
    var nameInput = document.getElementById("name");
    var emailInput = document.getElementById("email");
    var phoneInput = document.getElementById("phone");

    // ---------- Máscara de telefone: (11) 99999-9999 / (11) 9999-9999 ----------
    function formatPhoneBR(raw) {
      var digits = raw.replace(/\D/g, "").slice(0, 11);
      var len = digits.length;
      if (len === 0) return "";
      if (len <= 2) return "(" + digits;
      if (len <= 6) return "(" + digits.slice(0, 2) + ") " + digits.slice(2);
      if (len <= 10) return "(" + digits.slice(0, 2) + ") " + digits.slice(2, 6) + "-" + digits.slice(6);
      return "(" + digits.slice(0, 2) + ") " + digits.slice(2, 7) + "-" + digits.slice(7);
    }
    phoneInput.addEventListener("input", function () {
      phoneInput.value = formatPhoneBR(phoneInput.value);
    });

    // ---------- Alerta fancy (valida campo a campo e avisa de sucesso) ----------
    var formAlert = document.getElementById("formAlert");
    var formAlertBox = document.getElementById("formAlertBox");
    var formAlertIcon = document.getElementById("formAlertIcon");
    var formAlertTitle = document.getElementById("formAlertTitle");
    var formAlertMsg = document.getElementById("formAlertMsg");
    var formAlertOk = document.getElementById("formAlertOk");

    var alertFocusTarget = null;

    function showFormAlert(kind, title, message, focusEl, okLabel) {
      focusEl = focusEl || null;
      okLabel = okLabel || "Entendi";
      formAlertBox.classList.toggle("success", kind === "success");
      formAlertIcon.textContent = kind === "success" ? "✓" : "!";
      formAlertTitle.textContent = title;
      formAlertMsg.textContent = message;
      formAlertOk.textContent = okLabel;
      alertFocusTarget = focusEl;
      formAlert.classList.add("open");
      formAlert.setAttribute("aria-hidden", "false");
      formAlert.removeAttribute("inert");
      document.body.style.overflow = "hidden";
      formAlertOk.focus();
    }

    function closeFormAlert() {
      formAlert.classList.remove("open");
      formAlert.setAttribute("aria-hidden", "true");
      formAlert.setAttribute("inert", "");
      document.body.style.overflow = "";
      var target = alertFocusTarget;
      alertFocusTarget = null;
      if (target) {
        // espera a transição de fechar (0.3s) terminar antes de levar o
        // cursor pro campo, senão o foco rola a página no meio da animação.
        setTimeout(function () { target.focus(); }, 280);
      }
    }
    formAlertOk.addEventListener("click", closeFormAlert);

    function fieldErrorMessage(input) {
      if (input === nameInput) {
        return input.validity.valueMissing
          ? "Conta pra gente seu nome completo pra continuar."
          : "Digite seu nome completo (pelo menos 2 letras).";
      }
      if (input === emailInput) {
        return input.validity.valueMissing
          ? "Informe seu melhor e-mail pra gente entrar em contato."
          : "Esse e-mail não parece válido — confira e tente de novo.";
      }
      if (input === phoneInput) {
        return input.validity.valueMissing
          ? "Informe um telefone com DDD pra gente te chamar."
          : "Esse telefone não ficou completo — confira o DDD e o número.";
      }
      return "Confira esse campo e tente de novo.";
    }

    async function postLead(url, payload, timeoutMs) {
      timeoutMs = timeoutMs || 4000;
      var controller = new AbortController();
      var timer = setTimeout(function () { controller.abort(); }, timeoutMs);
      try {
        var res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        return res;
      } finally {
        clearTimeout(timer);
      }
    }

    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      var requiredInputs = [nameInput, emailInput, phoneInput];
      for (var i = 0; i < requiredInputs.length; i++) {
        var input = requiredInputs[i];
        if (!input.checkValidity()) {
          showFormAlert("error", "Confira esse campo", fieldErrorMessage(input), input);
          return;
        }
      }

      var payload = {
        name: nameInput.value.trim(),
        email: emailInput.value.trim(),
        phone: phoneInput.value.trim(),
        unit: form.elements.namedItem("unit").value.trim(),
        unit_slug: form.elements.namedItem("unit_slug").value.trim(),
        campaign: form.elements.namedItem("campaign").value,
      };

      btn.disabled = true;
      btn.textContent = "Enviando...";

      var res;
      try {
        res = await postLead(LEAD_ENDPOINT, payload);
      } catch (err) {
        // Sem fallback pra outra regiao aqui de proposito (ver comentario
        // no topo do arquivo) - so pedimos pra tentar de novo.
        console.warn("Falha ao enviar o lead:", err);
        showFormAlert("error", "Não conseguimos enviar", "Erro de conexão. Tente novamente em instantes.");
        btn.disabled = false;
        btn.textContent = "Quero minha vaga";
        return;
      }

      try {
        var data = await res.json();
        if (res.ok) {
          showFormAlert(
            "success",
            "Recebemos sua solicitação!",
            "Obrigado pelo contato! Em breve um consultor Wizard vai falar com você.",
            null,
            "Fechar"
          );
          form.reset();
        } else {
          showFormAlert(
            "error",
            "Não foi possível enviar",
            (data.details && data.details.join(", ")) || "Confira os dados e tente de novo."
          );
        }
      } catch (err) {
        showFormAlert("error", "Erro de conexão", "Tente novamente em instantes.");
      } finally {
        btn.disabled = false;
        btn.textContent = "Quero minha vaga";
      }
    });
  })();
  </script>
</Layout>
