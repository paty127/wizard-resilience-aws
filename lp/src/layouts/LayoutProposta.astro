---
import '../styles/proposta.css';

interface Props {
  title?: string;
}

const { title = 'Wizard | Volta às Aulas — Garanta sua vaga' } = Astro.props;
---

<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
